rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }

    // admins are created by hand in the console (document id = the admin's UID); no client can write here
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // shared vocabulary: everyone may READ without an account; only the administrator may create, edit or delete
    match /vocab/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['arabic','arabicNorm','mz','mzAlt','mzPron','mzDir','day','status','ut','deleted','updatedAt'])
        && request.resource.data.arabic is string && request.resource.data.arabic.size() >= 1 && request.resource.data.arabic.size() <= 300
        && request.resource.data.arabicNorm == id
        && request.resource.data.mz is string && request.resource.data.mz.size() <= 300
        && request.resource.data.mzAlt is list && request.resource.data.mzAlt.size() <= 10
        && request.resource.data.mzPron is string && request.resource.data.mzPron.size() <= 100
        && request.resource.data.mzDir in ['ltr','rtl']
        && (request.resource.data.day == null || (request.resource.data.day is int && request.resource.data.day >= 1 && request.resource.data.day <= 60))
        && request.resource.data.status in ['pending','translated']
        && request.resource.data.ut is number
        && request.resource.data.deleted is bool;
      allow delete: if isAdmin();
    }

    // data created by the previous version (kept, read-only, nothing is deleted)
    match /phrases/{id} { allow read: if true; allow write: if isAdmin(); }
    match /{other=**} { allow read, write: if false; }
  }
}
